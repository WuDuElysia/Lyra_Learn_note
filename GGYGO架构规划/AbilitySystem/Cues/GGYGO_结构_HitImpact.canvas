      "toSide": "top",
      "label": "调用期复制资源并调用播放 API"
    },
    {
      "id": "hitimpact-structure-config-playback",
      "fromNode": "hitimpact-structure-config",
      "fromSide": "bottom",
      "toNode": "hitimpact-structure-playback",
      "toSide": "top",
      "label": "提供选中粒子 / 声音引用"
    }
  ]
