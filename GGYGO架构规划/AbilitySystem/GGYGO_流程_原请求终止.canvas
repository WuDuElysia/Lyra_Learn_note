      "fromNode": "ga-term-e14",
      "fromSide": "bottom",
      "toNode": "ga-term-migration",
      "toSide": "top",
      "label": "共享构造拒绝；Combo原动作End、Boss拒hit，业务响应分别归属"
    },
    {
      "id": "ga-term-e-ga-early-asc-ended",
