      "toNode": "combo-f-main",
      "toSide": "bottom",
      "label": "攻击门开＋真实新攻击＋Next有效→StartStep"
    },
    {
      "id": "combo-fe-end",
      "fromNode": "combo-f-branch",
      "fromSide": "left",
      "toNode": "combo-f-end",
      "toSide": "right",
      "label": "移动门开且Qualified取消；无请求走自然轨迹"
    },
    {
      "id": "combo-fe-clean",
      "fromNode": "combo-f-branch",
      "fromSide": "bottom",
      "toNode": "combo-f-clean",
      "toSide": "top",
      "label": "原Cancel/watchdog/资源/Required失败→原Cleanup"
    },
    {
      "id": "combo-fe-finish",
      "fromNode": "combo-f-end",
      "fromSide": "bottom",
      "toNode": "combo-f-clean",
      "toSide": "left",
      "label": "原移动取消或两完成事实→固定Original End"
    },
    {
      "id": "combo-fe-input-gate",
      "fromNode": "combo-f-input",
      "fromSide": "left",
      "toNode": "combo-f-branch",
      "toSide": "top",
      "label": "真实新请求即时核原AttackGate"
    },
    {
      "id": "combo-fe-correct",
      "fromNode": "combo-f-input",
      "fromSide": "right",
      "toNode": "combo-f-correct",
      "toSide": "left",
      "label": "服务器接受/拒绝→强类型纠正"
    },
    {
      "id": "combo-fe-hit",
      "fromNode": "combo-f-window",
      "fromSide": "right",
      "toNode": "combo-f-hit",
      "toSide": "left",
      "label": "原Owned窗口Sweep命中"
    },
    {
      "id": "combo-fe-hit-normal",
      "fromNode": "combo-f-hit",
      "fromSide": "right",
      "toNode": "combo-f-hit-normal",
      "toSide": "left",
      "label": "明确无GE或有效GE；Builder成功"
    },
    {
      "id": "combo-fe-hit-fault",
      "fromNode": "combo-f-hit",
      "fromSide": "bottom",
      "toNode": "combo-f-hit-fault",
      "toSide": "top",
      "label": "必需GE校验失败或Builder失败"
    },
    {
      "id": "combo-fe-hit-end",
      "fromNode": "combo-f-hit-fault",
