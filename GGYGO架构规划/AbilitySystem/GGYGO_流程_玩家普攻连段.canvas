      "toSide": "right",
      "label": "合格移动取消；无请求保持自然轨迹"
    },
    {
      "id": "combo-fe-clean",
      "fromNode": "combo-f-branch",
      "fromSide": "bottom",
      "toNode": "combo-f-clean",
