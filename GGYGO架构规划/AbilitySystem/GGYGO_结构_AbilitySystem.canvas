    },
    {
      "id": "k3-task-uses-asc-playback",
      "fromNode": "k3-task-resource-consumer",
      "toNode": "k3-playback-asc",
      "toSide": "right",
      "label": "Task调用PlayAbilityMontage／IsPlaybackCurrent／ClearPlayback，持原Playback",
