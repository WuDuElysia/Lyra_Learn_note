      "toNode": "attr",
      "toSide": "left",
      "label": "GE 修改目标属性"
    },
    {
      "id": "e9",
      "fromNode": "attr",
      "fromSide": "left",
      "toNode": "asc",
      "toSide": "right",
      "label": "属性集由 ASC 管理"
    }
  ]
