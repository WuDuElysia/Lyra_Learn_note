      "label": "授予 GA / GE / Set"
    },
    {
      "id": "e7",
      "fromNode": "ga",
      "fromSide": "right",
      "toNode": "effect",
      "toSide": "left",
      "label": "执行伤害、Cue 与 Montage"
    },
    {
      "id": "e8",
      "fromNode": "effect",
