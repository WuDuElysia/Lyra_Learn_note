      "label": "服务器调用 Trace/GE"
    },
    {
      "id": "combo-se-network",
      "fromNode": "combo-s-ga",
      "fromSide": "bottom",
      "toNode": "combo-s-network",
      "toSide": "left",
      "label": "持有输入任务；接收权威纠正"
    },
    {
      "id": "combo-se-motion",
      "fromNode": "combo-s-ga",
      "fromSide": "right",
      "toNode": "combo-s-anim",
      "toSide": "left",
      "label": "调用原Source / CMC动作及资格接口"
    }
  ]
