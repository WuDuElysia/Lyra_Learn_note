      "toSide": "left",
      "label": "迁移期适配"
    },
    {
      "id": "e6",
      "fromNode": "compat",
      "fromSide": "right",
      "toNode": "play",
      "toSide": "left",
      "label": "旧表现记忆驱动 Select / BlendSpace"
    },
    {
      "id": "e7",
      "fromNode": "compat",
      "fromSide": "left",
      "toNode": "future",
      "toSide": "right",
      "label": "后续移除兼容层"
    },
    {
      "id": "combo_play_events",
      "fromNode": "combo_entry",
      "fromSide": "right",
      "toNode": "combo_window",
      "toSide": "left",
      "label": "播放推进触发各窗口"
    },
    {
      "id": "combo_default_end",
      "fromNode": "combo_window",
      "fromSide": "right",
      "toNode": "combo_end",
      "toSide": "left",
      "label": "未消费换段请求，Section 默认前进"
    },
    {
      "id": "combo_end_locomotion",
      "fromNode": "combo_end",
      "fromSide": "right",
      "toNode": "combo_return",
      "toSide": "left",
      "label": "End 结束并按 Montage 参数混出"
    }
  ]
}
