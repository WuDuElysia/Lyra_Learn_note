      "fromNode": "base",
      "fromSide": "right",
      "toNode": "source_binding",
      "toSide": "left",
      "label": "Base持有immutable publication handle"
    },
    {
      "id": "base_source_sink",
      "fromNode": "base",
      "fromSide": "right",
      "toNode": "source",
      "toSide": "left",
      "label": "调用公开Publish/Retire，仅配置与生命周期"
    },
    {
      "id": "source_binding_moves",
      "fromNode": "source_binding",
      "fromSide": "right",
      "toNode": "source",
      "toSide": "left",
      "label": "CMC/SavedMove有界保留原const binding"
    },
    {
      "id": "action_pose_abp_node",
      "fromNode": "combo_slot_gate",
      "fromSide": "right",
      "toNode": "action_pose_slot",
      "toSide": "left",
