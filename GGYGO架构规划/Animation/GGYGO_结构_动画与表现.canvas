    },
    {
      "id": "action_pose_task_acquire_poll",
      "fromNode": "montage_callers",
      "fromSide": "right",
      "toNode": "action_pose_contract",
      "toSide": "left",
      "label": "Task启动Acquire / 原生Tick Poll原ticket"
    },
    {
      "id": "action_pose_contract_node_read",
      "fromNode": "action_pose_contract",
      "fromSide": "top",
      "toNode": "action_pose_slot",
      "toSide": "bottom",
      "label": "读取CheckCapability、epoch与故障序号"
    },
    {
      "id": "action_pose_native_output",
      "fromNode": "action_pose_slot",
      "fromSide": "left",
      "toNode": "abp",
      "toSide": "right",
      "label": "Body local translation输出接原空间转换/惯性化"
    },
    {
      "id": "action_pose_failure_ga",
      "fromNode": "action_pose_contract",
      "fromSide": "left",
      "toNode": "combo_ga",
      "toSide": "right",
