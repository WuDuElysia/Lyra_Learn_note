    },
    {
      "id": "action_pose_execution_boundary",
      "fromNode": "action_pose_slot",
      "fromSide": "right",
      "toNode": "action_pose_boundary",
      "toSide": "top",
      "label": "只改Mesh Body XYZ余量，物理归CMC"
    },
    {
      "id": "steering_cmc_owner",
      "fromNode": "source",
      "fromSide": "bottom",
      "toNode": "steering_snapshot",
      "toSide": "top",
