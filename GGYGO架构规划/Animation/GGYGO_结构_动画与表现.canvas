      "label": "Failed/Invalidated经原Task清理后OnFailed，GA核原资源强制End"
    },
    {
      "id": "action_motion_ga_binding",
      "fromNode": "combo_ga",
      "fromSide": "right",
      "toNode": "action_motion_binding",
      "toSide": "left",
      "label": "调用BuildSourceBinding；持原Main配置与CMC句柄"
    },
    {
      "id": "action_pose_execution_boundary",
      "fromNode": "action_pose_slot",
      "fromSide": "right",
      "toNode": "action_pose_boundary",
      "toSide": "top",
      "label": "只改Mesh Body；胶囊执行与验证边界见下方"
    }
  ]
}
