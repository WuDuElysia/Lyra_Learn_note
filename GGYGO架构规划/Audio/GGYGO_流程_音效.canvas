    },
    {
      "id": "af-persistent-evidence",
      "fromNode": "af-persistent",
      "fromSide": "bottom",
      "toNode": "af-evidence",
      "toSide": "top",
      "label": "独立目标不由 one-shot 冒烟关闭"
    }
  ]
