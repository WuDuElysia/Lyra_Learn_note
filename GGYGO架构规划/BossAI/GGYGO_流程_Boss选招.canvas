		{"id":"nav","type":"text","text":"# Boss 选招｜流程子图\nA–C 当前实现。类关系见 [[GGYGO_结构_BossAI.canvas|结构图]]；[[计划_BOSSAI]]。","x":0,"y":0,"width":1690,"height":130,"color":"6"},
