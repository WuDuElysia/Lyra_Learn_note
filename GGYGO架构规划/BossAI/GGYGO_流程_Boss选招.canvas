    },
    {
      "id": "e7",
      "fromNode": "random",
      "fromSide": "bottom",
      "toNode": "recover",
      "toSide": "top",
      "label": "全部合格候选惩罚权重为零"
    },
    {
      "id": "e8",
      "fromNode": "recover",
      "fromSide": "left",
      "toNode": "random",
      "toSide": "left",
      "label": "恢复基础权重 → 本次抽签"
    },
    {
      "id": "e9",
      "fromNode": "tick",
      "fromSide": "bottom",
      "toNode": "fail",
      "toSide": "bottom",
      "label": "配置无效 → 整集拒绝"
    }
  ]
