      "toSide": "left",
      "label": "StoreActionSelection + Blackboard Tag"
    },
    {
      "id": "e4",
      "fromNode": "request",
      "fromSide": "right",
      "toNode": "execute",
      "toSide": "left",
      "label": "Accepted + 固定Original → 消费原同步/异步Completed"
    },
    {
      "id": "e5",
      "fromNode": "request",
      "fromSide": "right",
      "toNode": "fail",
      "toSide": "left",
      "label": "来源失效/拒绝/Busy/无原身份 → 清本等待"
    },
    {
      "id": "e6",
      "fromNode": "candidates",
      "fromSide": "bottom",
      "toNode": "fail",
      "toSide": "left",
      "label": "候选为空 → ClearValue / Failed"
    },
    {
      "id": "e7",
      "fromNode": "random",
      "fromSide": "bottom",
      "toNode": "recover",
      "toSide": "top",
      "label": "全部合格候选惩罚权重为零"
    },
    {
      "id": "e8",
      "fromNode": "recover",
      "fromSide": "left",
      "toNode": "random",
      "toSide": "left",
      "label": "恢复基础权重 → 本次抽签"
    },
    {
      "id": "e9",
      "fromNode": "tick",
      "fromSide": "bottom",
      "toNode": "fail",
      "toSide": "bottom",
      "label": "配置无效 → 整集拒绝"
    }
  ]
