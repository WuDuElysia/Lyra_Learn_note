      "toNode": "empty",
      "toSide": "top",
      "label": "Push/栈失败 → Manager Stopped"
    },
    {
      "id": "e7",
      "fromNode": "empty",
      "fromSide": "right",
      "toNode": "projection",
      "toSide": "left",
      "label": "已有确认的保留 Cache 只读；首次失败 false"
    },
    {
      "id": "e8",
      "fromNode": "collision",
      "fromSide": "left",
      "toNode": "output",
      "toSide": "right",
      "label": "Prepare Success → 同一 Prepared"
    },
    {
      "id": "e9",
      "fromNode": "provider-ready",
      "fromSide": "bottom",
      "toNode": "engine",
      "toSide": "top",
      "label": "实际 Ready → 原身份 Activate"
    },
    {
      "id": "e10",
      "fromNode": "engine",
      "fromSide": "bottom",
      "toNode": "empty",
      "toSide": "top",
      "label": "Stopped / 管线 Result Failure"
    },
    {
      "id": "e11",
      "fromNode": "output",
      "fromSide": "right",
      "toNode": "projection",
      "toSide": "left",
      "label": "原生 Cache + 确认资格（只读）"
    },
    {
      "id": "e12",
      "fromNode": "output",
      "fromSide": "left",
      "toNode": "empty",
      "toSide": "right",
      "label": "修饰/Commit/混合/发布校验失败"
    }
  ]
}
