    },
    {
      "id": "e7",
      "fromNode": "aggregate",
      "fromSide": "left",
      "toNode": "offset",
      "toSide": "right",
      "label": "Evaluate完整Success：OutView + OutRequest"
    },
    {
      "id": "e8",
      "fromNode": "offset",
      "fromSide": "bottom",
      "toNode": "collision",
      "toSide": "top",
      "label": "Offset 后最终位置"
    },
    {
      "id": "e9",
      "fromNode": "pull",
      "fromSide": "bottom",
      "toNode": "fallback",
      "toSide": "top",
      "label": "委托/类/栈/求值Failure → 停止发布"
    },
    {
      "id": "e10",
      "fromNode": "blend",
      "fromSide": "bottom",
      "toNode": "aggregate",
      "toSide": "top",
      "label": "相同遮盖关系 / 实际贡献"
    },
    {
      "id": "e11",
      "fromNode": "aggregate",
      "fromSide": "left",
      "toNode": "collision",
      "toSide": "right",
      "label": "聚合 Request"
    },
    {
      "id": "e12",
      "fromNode": "collision",
      "fromSide": "bottom",
      "toNode": "write",
      "toSide": "top",
      "label": "Resolve Success → Prepared候选（尚未发布）"
    }
  ]
}
