      "toSide": "left",
      "label": "权重更新 → 裁剪隐藏项"
    },
    {
      "id": "e6",
      "fromNode": "prune",
      "fromSide": "right",
      "toNode": "blend",
      "toSide": "left",
      "label": "活跃栈 → BlendStack"
    },
    {
      "id": "e7",
      "fromNode": "blend",
      "fromSide": "left",
      "toNode": "offset",
      "toSide": "right",
      "label": "合成 View"
    },
    {
      "id": "e8",
      "fromNode": "offset",
      "fromSide": "bottom",
      "toNode": "collision",
      "toSide": "top",
      "label": "Offset 后最终位置"
    },
    {
      "id": "e9",
      "fromNode": "pull",
      "fromSide": "bottom",
      "toNode": "fallback",
      "toSide": "top",
      "label": "更新后活动栈为空"
    },
    {
      "id": "e10",
      "fromNode": "blend",
      "fromSide": "bottom",
      "toNode": "aggregate",
      "toSide": "top",
      "label": "相同遮盖关系 / 实际贡献"
    },
    {
      "id": "e11",
      "fromNode": "aggregate",
      "fromSide": "left",
      "toNode": "collision",
      "toSide": "right",
      "label": "聚合 Request"
    },
    {
      "id": "e12",
      "fromNode": "collision",
      "fromSide": "bottom",
      "toNode": "write",
      "toSide": "top",
      "label": "最终安全 View"
    }
  ]
}
