		},
		{
			"id": "e8",
			"fromNode": "replace",
			"fromSide": "right",
			"toNode": "restore",
			"toSide": "left",
			"label": "仅当前 generation 可清"
		},
		{
			"id": "e9",
			"fromNode": "default",
			"fromSide": "bottom",
			"toNode": "unbind",
			"toSide": "top",
			"label": "原Extension / ASC生命周期 → typed Notice"
		},
		{
			"id": "e10",
			"fromNode": "release-reset",
			"fromSide": "right",
			"toNode": "restore",
			"toSide": "bottom",
			"label": "委托仍绑定且Manager Running：后续Prepare重新选类"
		},
		{
			"id": "e11",
			"fromNode": "unbind",
			"fromSide": "right",
			"toNode": "hero-guard",
			"toSide": "left",
			"label": "原订阅的typed Ready / Refreshed / Released"
		},
		{
			"id": "e12",
			"fromNode": "hero-guard",
			"fromSide": "bottom",
			"toNode": "release-reset",
			"toSide": "top",
			"label": "匹配原H Released → 退休原资源并复核后继"
		},
		{
			"id": "e13",
			"fromNode": "endplay",
			"fromSide": "right",
			"toNode": "release-reset",
			"toSide": "left",
			"label": "EndPlay按自身原生命周期释放资源"
		}
	]
}
