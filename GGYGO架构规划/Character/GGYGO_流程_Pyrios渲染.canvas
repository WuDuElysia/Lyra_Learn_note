			"fromNode": "begin",
			"fromSide": "bottom",
			"toNode": "no-match",
			"toSide": "left",
			"label": "未激活 → 保持无运行资源"
		},
		{
			"id": "e-refresh-no-match",
			"fromNode": "refresh",
			"fromSide": "bottom",
			"toNode": "no-match",
			"toSide": "top",
			"label": "输入缺失/无匹配 → 无 MID Tick"
		},
		{
			"id": "e-refresh-outline",
			"fromNode": "refresh",
			"fromSide": "right",
			"toNode": "outline",
			"toSide": "left",
			"label": "有 MID、开关及显式材质 → UpdateOutline()"
		},
		{
			"id": "e-refresh-lighting",
			"fromNode": "refresh",
			"fromSide": "right",
			"toNode": "lighting",
			"toSide": "left",
			"label": "有 MID → 立即 UpdateLighting()"
		},
		{
			"id": "e-refresh-shader",
			"fromNode": "refresh",
			"fromSide": "right",
			"toNode": "shader",
			"toSide": "left",
			"label": "已配置父材质 → 表面 MID"
		},
		{
			"id": "e-outline-shader",
			"fromNode": "outline",
			"fromSide": "right",
			"toNode": "shader",
			"toSide": "top",
			"label": "跟随 Pose 的背面扩张壳 → 轮廓"
		},
		{
			"id": "e-lighting-shader",
			"fromNode": "lighting",
			"fromSide": "right",
			"toNode": "shader",
			"toSide": "bottom",
			"label": "主光方向/颜色/受限强度/遮挡 → Emissive 求值"
		},
		{
			"id": "e-lighting-tick",
			"fromNode": "lighting",
			"fromSide": "bottom",
			"toNode": "tick",
			"toSide": "top",
			"label": "启用 0.1 s Tick"
		},
		{
			"id": "e-tick-lighting",
			"fromNode": "tick",
			"fromSide": "left",
			"toNode": "lighting",
			"toSide": "left",
			"label": "Mesh/槽仍有效 → UpdateLighting()"
		},
		{
			"id": "e-tick-end",
			"fromNode": "tick",
			"fromSide": "right",
			"toNode": "end",
			"toSide": "left",
			"label": "Mesh/槽失效 → ReleaseMaterials()"
		},
		{
			"id": "e-no-match-end",
			"fromNode": "no-match",
			"fromSide": "right",
			"toNode": "end",
			"toSide": "left",
			"label": "停用/注销/EndPlay → 幂等释放"
		},
		{
			"id": "e-editor-bind-preview",
			"fromNode": "editor-bind",
			"fromSide": "right",
			"toNode": "editor-preview",
			"toSide": "left",
			"label": "默认槽位的三个 MI → 模型与角色蓝图视口"
		},
		{
			"id": "e-migration-begin",
			"fromNode": "migration-gate",
			"fromSide": "left",
			"toNode": "begin",
			"toSide": "left",
			"label": "已保存 BP 的显式配置 → 运行组件"
		}
	]
}
