    },
{"id": "nav-area-query", "fromNode": "nav", "fromSide": "right", "toNode": "area-projectile-flow", "toSide": "top", "label": "范围窗／原生弹体段"},
{"id": "area-query-ge", "fromNode": "area-projectile-flow", "fromSide": "bottom", "toNode": "ge", "toSide": "right", "label": "去重命中由原 GA 结算"}
