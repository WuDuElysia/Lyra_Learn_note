      "toNode": "remote",
      "toSide": "top",
      "label": "持有当前远端资源"
    },
    {
      "id": "values-remote",
      "fromNode": "values",
      "fromSide": "right",
      "toNode": "remote",
      "toSide": "left",
      "label": "提供原播放参数和服务器起点"
    }
  ]
