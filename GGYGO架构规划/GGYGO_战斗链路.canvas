		{"id":"e6","fromNode":"s4","fromSide":"bottom","toNode":"s5","toSide":"top","label":"通过"},
		{"id":"e7","fromNode":"s5","fromSide":"right","toNode":"s6","toSide":"left","label":"启动 Montage 任务"},
		{"id":"e8","fromNode":"s6","fromSide":"right","toNode":"s7","toSide":"left","label":"EventReceived"},
		{"id":"e9","fromNode":"s7","fromSide":"right","toNode":"s8","toSide":"left","label":"开窗后每帧扫"},
		{"id":"e10","fromNode":"s8","fromSide":"top","toNode":"s9","toSide":"bottom","label":"OnMeleeHit"},
		{"id":"e11","fromNode":"s9","fromSide":"right","toNode":"s10","toSide":"left","label":"GE Spec"},
		{"id":"e12","fromNode":"s10","fromSide":"bottom","toNode":"s11","toSide":"top","label":"元属性"},
		{"id":"e13","fromNode":"s11","fromSide":"top","toNode":"s12","toSide":"left","label":"委托与 Cue"}
	]
}
