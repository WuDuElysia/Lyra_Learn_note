		{"id":"e-c-anim","fromNode":"ch-c","fromSide":"right","toNode":"anim","toSide":"left","label":"驱动"},
		{"id":"e-c-example","fromNode":"ch-c","fromSide":"bottom","toNode":"attack-example","toSide":"top","label":"综合示例"},
		{"id":"e-example-conflict","fromNode":"attack-example","fromSide":"right","toNode":"montage-conflict","toSide":"bottom","label":"注意位移叠加"}
	]
