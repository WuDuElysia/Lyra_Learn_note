		{"id":"e-why-intent","fromNode":"why-intent","fromSide":"left","toNode":"path-a","toSide":"right","label":"将来的扩展方向"},
		{"id":"e-intent-boundary","fromNode":"intent","fromSide":"right","toNode":"boundary","toSide":"left","label":"受此约束"},
		{"id":"e-intent-arb","fromNode":"intent","fromSide":"bottom","toNode":"arbitration","toSide":"top","label":"提交候选请求"}
	]
}