      "toNode": "nested",
      "toSide": "top",
      "label": "原生委托同步重入"
    },
    {
      "id": "p4",
      "fromNode": "nested",
      "fromSide": "left",
      "toNode": "pre",
      "toSide": "bottom",
      "label": "嵌套 Modifier"
    },
    {
      "id": "p5",
      "fromNode": "post",
      "fromSide": "right",
      "toNode": "publish",
      "toSide": "right",
      "label": "直接属性已写入→移除原帧/Flush"
    },
    {
      "id": "p6",
      "fromNode": "delivery-lifecycle",
      "fromSide": "bottom",
      "toNode": "consumer",
      "toSide": "bottom",
      "label": "Delivered→BroadcastMessage同步回调"
    },
    {
      "id": "p8",
      "fromNode": "publish",
      "fromSide": "bottom",
      "toNode": "next",
      "toSide": "bottom",
      "label": "引擎继续后续执行"
    },
    {
      "id": "p-current-calculation",
      "fromNode": "post",
      "fromSide": "bottom",
      "toNode": "calculate-current",
      "toSide": "top",
      "label": "meta清理回调返回→重算当前目标"
    },
    {
      "id": "p-current-confirmed",
      "fromNode": "calculate-current",
      "fromSide": "bottom",
      "toNode": "publish",
      "toSide": "top",
      "label": "OwnPost确认→移原帧/Flush"
    },
    {
      "id": "p-current-rejected",
      "fromNode": "calculate-current",
      "fromSide": "right",
      "toNode": "current-rejected",
      "toSide": "left",
      "label": "Rejected / Stale / 未确认"
    },
    {
      "id": "p-current-rejected-flush",
      "fromNode": "current-rejected",
      "fromSide": "left",
      "toNode": "publish",
      "toSide": "right",
      "label": "撤原Damage候选→移帧/Flush其余事实"
    },
    {
      "id": "p-message-lifecycle",
      "fromNode": "publish",
      "fromSide": "right",
      "toNode": "delivery-lifecycle",
      "toSide": "left",
      "label": "逐项PublishMessageResult"
    },
    {
      "id": "p-client-native-drained",
      "fromNode": "client-max-request",
      "fromSide": "right",
      "toNode": "client-max-project",
      "toSide": "left",
      "label": "Super收尾后消费原弱源请求"
    },
    {
      "id": "p-client-source-invalid",
      "fromNode": "client-max-request",
      "fromSide": "bottom",
      "toNode": "client-max-rejected",
      "toSide": "bottom",
      "label": "原来源失效/请求拒绝"
    },
    {
      "id": "p-client-projection-failed",
      "fromNode": "client-max-project",
      "fromSide": "right",
      "toNode": "client-max-rejected",
      "toSide": "left",
      "label": "非法模式/数值/开放batch/未确认"
    }
  ]
}
