      "toNode": "pre",
      "toSide": "bottom",
      "label": "嵌套 Modifier"
    },
    {
      "id": "p5",
      "fromNode": "post",
      "fromSide": "bottom",
      "toNode": "publish",
      "toSide": "top",
      "label": "移除配对帧→Flush门禁允许发布"
    },
    {
      "id": "p6",
      "fromNode": "publish",
      "fromSide": "left",
      "toNode": "consumer",
      "toSide": "right",
      "label": "本地消息（目标接入）"
    },
    {
      "id": "p8",
      "fromNode": "publish",
      "fromSide": "bottom",
      "toNode": "next",
      "toSide": "bottom",
      "label": "引擎继续后续执行"
    }
  ]
}
