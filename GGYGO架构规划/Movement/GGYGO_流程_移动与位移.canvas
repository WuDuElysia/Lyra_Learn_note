    },
    {
      "id": "native-prepare-original-failure",
      "fromNode": "physics",
      "fromSide": "bottom",
      "toNode": "evaluation-failure",
      "toSide": "right",
      "label": "原Prepare失败→Report原Origin；旧源仅退场"
    }
  ]
}
