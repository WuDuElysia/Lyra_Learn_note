		{"id":"e5","fromNode":"cmc","fromSide":"bottom","toNode":"saved","toSide":"top","label":"SetMoveFor／PostUpdate：起始语义＋原Input／Prepared"},
		{"id":"e6","fromNode":"cmc","fromSide":"right","toNode":"frame","toSide":"left","label":"发布只读语义"},
		{"id":"e7","fromNode":"rms","fromSide":"left","toNode":"saved","toSide":"right","label":"Clone保留原引用，进入SavedRootMotion"},
		{"id":"movement-test-floor-cmc","fromNode":"movement-test-map","fromSide":"right","toNode":"cmc","toSide":"right","label":"为 CMC 原生物理查询提供阻挡地面"},
		{"id":"action-data-cmc","fromNode":"action-profile","fromSide":"right","toNode":"action-executor","toSide":"left","label":"提供累计轨迹与配置"},
		{"id":"action-cmc-rms","fromNode":"action-executor","fromSide":"right","toNode":"action-rms","toSide":"left","label":"申请/释放唯一动作位移源"},
		{"id":"cmc-evaluation","fromNode":"cmc","fromSide":"right","toNode":"locomotion-evaluation","toSide":"left","label":"普通段／原生Prepare调用纯区间数学"},
		{"id":"evaluation-profile","fromNode":"locomotion-evaluation","fromSide":"left","toNode":"sampler","toSide":"right","label":"调用：EvaluateInterval，双Loop必需"},
		{"id":"cmc-local-asc-subscription","fromNode":"cmc","fromSide":"right","toNode":"local-asc-subscription","toSide":"left","label":"持原订阅；Cache／CantMove／EndPlay消费"},
		{"id":"rms-original-cmc-prepare","fromNode":"rms","fromSide":"top","toNode":"cmc","toSide":"top","label":"native Prepare请求原CMC：Origin／真实sim／tick→Prepared"},
		{"id":"saved-original-cmc-replay","fromNode":"saved","fromSide":"left","toNode":"cmc","toSide":"left","label":"PrepMoveFor先装原输入；Before一次Consume"}
	]
}